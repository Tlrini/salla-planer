# Copy to /opt/salla-worker/.env on the GPU VM. Never commit .env.

# Public address of the app (the worker talks to it over HTTPS).
APP_URL=https://planner.example.com

# Same value as SCAN_WORKER_TOKEN in the app's .env (at least 32 characters), e.g. from
#   openssl rand -hex 32
SCAN_WORKER_TOKEN=

# Exit (and power the VM off) after this many minutes without scans.
IDLE_EXIT_MINUTES=10
# Give up on one scan after this long.
MAX_JOB_MINUTES=90
# Triangles of a detailed model (more = finer but slower on tablets); a quick scan keeps 60 %.
TARGET_TRIANGLES=150000

# Meshroom pipeline template and optional --paramOverrides items (space separated), e.g.
#   MESHROOM_PARAMS=Texturing:textureSide=4096
# MESHROOM_PARAMS applies to detailed scans, MESHROOM_PARAMS_QUICK to quick ones.
MESHROOM_PIPELINE=photogrammetry
MESHROOM_PARAMS=
MESHROOM_PARAMS_QUICK=DepthMap:downscale=4 Meshing:maxPoints=1000000 Texturing:textureSide=2048
