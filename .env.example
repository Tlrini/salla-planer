# Copy to .env and fill in. Never commit .env.

# Public domain of the app (its DNS A record points to the cloud VM). Use localhost to try the
# HTTPS setup on your own PC.
DOMAIN=planner.example.com

# Used only on the first start (empty database) to create the first administrator; afterwards
# manage users in Administrimi. In production the password must have at least 12 characters and
# must not be this example value.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# --- Only for `npm start` without Docker (office PC on the local network) ---
# PORT=3000
# COOKIE_SECURE=false
# TRUST_PROXY=           # proxy IPs allowed to set X-Forwarded-For; empty = no proxy
