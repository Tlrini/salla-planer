# Copy to .env and fill in. Never commit .env.

# Public domain of the app (its DNS A record points to the cloud VM). Use localhost to try the
# HTTPS setup on your own PC.
DOMAIN=planner.example.com

# Used only on the first start (empty database) to create the first administrator; afterwards
# manage users in Administrimi. In production the password must have at least 12 characters and
# must not be this example value.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Secret of the GPU scan worker (Beta 5) and of the server's auto-stop, at least 32 characters
# (e.g. `openssl rand -hex 32`); empty = scanning off and deploy/idle-stop.sh refuses to run.
# The same value goes into the GPU worker's .env.
SCAN_WORKER_TOKEN=

# --- Read only by the host scripts in deploy/ (docs/deploy-cloud.md) ---
# Values with spaces or $ must be in single quotes: the scripts read this file with sh.
# S3 target of deploy/backup-sync.sh (also run by idle-stop.sh before powering off).
# BACKUP_TARGET=s3://salla-backups-name/salla
# Power the server off after this many minutes without use (0 = never).
# IDLE_STOP_MINUTES=60
# Scans waiting longer than this for the GPU no longer keep the server on.
# SCAN_WAIT_LIMIT_MINUTES=120

# --- Only for `npm start` without Docker (office PC on the local network) ---
# PORT=3000
# COOKIE_SECURE=false
# TRUST_PROXY=           # proxy IPs allowed to set X-Forwarded-For; empty = no proxy
